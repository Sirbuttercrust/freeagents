// Free Agents data model. See MISSION.md "The hire loop" and "Core capabilities"
// for the semantics this schema encodes.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bidirectional GitHub proof status for an agent's DID <-> GitHub handle
// binding. See spec/work-history-extension-v1.md "accounts".
enum ProofStatus {
  unverified
  pending
  verified
}

// Mirrors the hire loop in MISSION.md. A job only "exists" once confirmed,
// but the row is opened as a draft from the buyer's brief so both the brief
// and its hash have somewhere to live while acceptance criteria are worked
// out.
enum JobStatus {
  draft
  proposed
  confirmed
  submitted
  completed
  declined
  // R-12 (ENT-7.2): non-merge outcomes are recorded, not hidden.
  closed_unmerged
  stale
  // R-31 (D3 2026-08-22): a buyer walk-away, recorded as a timing fact.
  withdrawn
}

// ENT-9: v1 records intent and nothing else. Exactly one member, on purpose:
// a second state is what a transfer would need, so "no transfer" is a
// property of this enum rather than a rule someone has to remember.
enum SettlementState {
  recorded_intent
}

// One account, many roles (R-39 completion, 2026-09-01): the same account
// may run agents on one job and buy on another, including hiring its own
// agent. "Operator" and "buyer" are roles an account plays on a given job,
// never a type of account: there is no `type` column here, and never will
// be. githubLogin and passkeySubject are both unique so a session resolves
// to exactly one Account: today githubLogin is indexed but not unique, so
// two accounts could claim the same login and session resolution would be
// ambiguous, which is itself an impersonation path. passkeySubject is
// nullable: an account may hold a GitHub login only, a passkey only, or
// both, and only a value that actually exists can collide.
model Account {
  did            String   @id
  githubLogin    String   @unique
  passkeySubject String?  @unique
  createdAt      DateTime @default(now())

  agents Agent[]
}

// The delegation column is Json on purpose (R-2): the stored bytes are the
// credential the operator's wallet signed, kept verbatim so a third party
// can verify it off-platform (ENT-3.1). Projecting it to named columns would
// drop the fields the signature covers and break verification.
model Agent {
  did         String      @id
  // The field name records the ROLE the account plays on this agent
  // (operating it), not a reference to a retired "Operator" type: the
  // referenced row is an Account (R-39 completion). Kept as `operatorDid`
  // / `operator` rather than renamed, because the rename that matters is
  // the entity's, not every role-scoped field that already named the role
  // correctly.
  operatorDid String
  delegation  Json
  name        String
  skills      String[]
  // Nullable: the GitHub binding lands with R-3/R-4 (ENT-5); an agent can be
  // delegated before any account proof exists.
  githubLogin String?
  proofStatus ProofStatus @default(unverified)
  createdAt   DateTime    @default(now())

  operator Account @relation(fields: [operatorDid], references: [did])

  jobs              Job[]
  credentials       Credential[]
  keyRotations      KeyRotation[]
  compromiseReports CompromiseReport[]

  @@index([operatorDid])
  @@index([githubLogin])
}

model Job {
  id                String    @id @default(cuid())
  buyerDid          String
  agentDid          String
  repository        String
  // The buyer's own prose, stored verbatim (ENT-4): a third party holding it
  // can recompute briefHash without calling this service.
  brief             String
  briefHash         String
  confirmedSpecHash String?
  // The acceptance criteria as last proposed (ENT-6, D2): a structured list,
  // exchanged while the job is in "proposed", immutable once confirmed.
  // Each entry carries acceptedByBuyer and acceptedByAgent independently
  // (ENT-6.2): a single shared flag cannot record two parties agreeing.
  // Nullable and additive: empty until the exchange starts (R-8).
  criteria          Json?
  status            JobStatus @default(proposed)
  pullRequestUrl    String?
  // The observed merge facts (ENT-7.1): written only when the pull request
  // merges, from GitHub's report, never from a party's claim. Nullable:
  // null until completion.
  mergeCommit       String?
  mergedAt          DateTime?
  confirmedAt       DateTime?
  submittedAt       DateTime?
  // The instant the pull request goes stale (R-12, D3 2026-08-22): written
  // by submitPullRequest as submittedAt + 30 days, null until submitted and
  // for rows written before R-12.
  deadline          DateTime?
  createdAt         DateTime  @default(now())

  agent        Agent         @relation(fields: [agentDid], references: [did])
  completedJob CompletedJob?
  credential   Credential?
  settlement   Settlement?
  review       Review?

  @@index([agentDid])
  @@index([buyerDid])
}

// Created only when a Job transitions to "completed" (its pull request
// merged). Neither storage driver inserts a row here today (the completed
// facts live on the Job row itself, and PrismaJobRepository derives this
// shape from it); the model exists for the fields R-11's completeJob
// signature already promises. Credential and Review both bind to Job
// directly instead (see the comments on each), for exactly the reason a
// CompletedJob foreign key could never be satisfied by either driver.
model CompletedJob {
  id          String   @id @default(cuid())
  jobId       String   @unique
  buyerDid    String
  agentDid    String
  mergeCommit String
  completedAt DateTime

  job Job @relation(fields: [jobId], references: [id])

  // Candidate key R-11's completeJob/complete route always populates,
  // even though the current storage drivers never insert a row here (the
  // completed record is derived from the Job row itself). Kept for the
  // shape a future driver may need; nothing in this codebase binds a
  // foreign key against it any more (see the Job-targeting relations on
  // the receipt and review models below, and the R-35 lap B note there).
  @@unique([id, buyerDid, agentDid])
}

// completedJobId targets Job.id, not CompletedJob.id: neither storage driver
// ever inserts a CompletedJob row (PrismaJobRepository.complete updates the
// Job row directly, and findCompletedByJobId derives the completed record
// from it, returning id: job.id), so a foreign key into CompletedJob could
// never be satisfied and every credential insert would fail on Postgres.
model Credential {
  id             String   @id @default(cuid())
  completedJobId String   @unique
  subjectDid     String
  document       Json
  // R-17: the one fact evidenceTier needs that never belongs inside the
  // signed document (ENT-8.3 forbids a judgement inside the signature
  // envelope). Nullable with an application-level false default so an
  // existing row written before this column existed reads back as
  // unverified rather than crashing a migration or silently promoting.
  repositoryPublic Boolean?
  issuedAt       DateTime @default(now())

  completedJob Job   @relation(fields: [completedJobId], references: [id], onUpdate: NoAction)
  subject      Agent @relation(fields: [subjectDid], references: [did])

  @@index([subjectDid])
}

// R-29 (ENT-8.4): a rotation records the superseded key and when, so a
// credential signed by an old key still verifies. Append-only: rows are
// never updated or deleted, for the same reason a credential is stored
// verbatim.
model KeyRotation {
  id        String   @id @default(cuid())
  agentDid  String
  fromKey   String
  toKey     String
  rotatedAt DateTime @default(now())

  agent Agent @relation(fields: [agentDid], references: [did])

  @@index([agentDid])
}

// R-16 (ENT-8.4): an operator reports one of the agent's keys compromised
// from an instant. Append-only, like KeyRotation, and for the same reason:
// nothing is deleted or hidden, so the window stays visible and work signed
// inside it can be shown as disputed without amending a signed credential
// (ENT-8.3 forbids a judgement inside the signature envelope).
model CompromiseReport {
  id         String   @id @default(cuid())
  agentDid   String
  key        String
  since      DateTime
  reportedAt DateTime @default(now())

  agent Agent @relation(fields: [agentDid], references: [did])

  @@index([agentDid])
}

// R-26 (ENT-9): designed in, not shipped. The money columns exist so
// settlement does not have to be retrofitted into a completed job record
// later, and every one of them is nullable because nothing in v1 writes one.
// One row per job: the fee attaches to a completed hire (ENT-9.3).
model Settlement {
  id          String          @id @default(cuid())
  jobId       String          @unique
  amount      Decimal?
  currency    String?
  platformFee Decimal?
  state       SettlementState @default(recorded_intent)
  recordedAt  DateTime        @default(now())

  job Job @relation(fields: [jobId], references: [id])
}

// One review per completed job (ENT-10, R-22 issue 29). completedJobId
// targets Job.id, the same repoint R-35 lap B made for Credential and for
// the identical reason: neither storage driver ever inserts a CompletedJob
// row, so a foreign key into CompletedJob could never be satisfied and
// every review insert would fail on Postgres. authorDid and agentDid ride
// beside the review as the buyer's and the agent's identity at write time;
// eligibility itself (completed status, exact buyer, exact agent) is
// checked by the domain layer against the Job row before a Review is ever
// built (src/domain/review.ts, assertReviewEligible), not by a database
// constraint, because JobStatus is not a value Prisma's relation syntax can
// gate on. No rating column exists anywhere on this model (ENT-10.2): a
// review is text, never a number.
model Review {
  id             String   @id @default(cuid())
  completedJobId String   @unique
  authorDid      String
  agentDid       String
  text           String
  createdAt      DateTime @default(now())

  completedJob Job @relation(fields: [completedJobId], references: [id])

  @@index([agentDid])
}
