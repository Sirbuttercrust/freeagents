# Copy this file to .env.local and fill in real values for your deployment.
# Every variable here is also declared in blocklet.yml (Blocklet Server reads
# environments: from there); this file exists for anyone running the product
# without Blocklet Server. tests/architecture/config-agreement.test.ts holds
# the two files in agreement: a variable added to one and not the other is
# the drift that test catches.
#
# Values below are placeholders, never a real endpoint, contract, address,
# key, or connection string. No default in blocklet.yml points at a network;
# this file does not either.

# --- Database (required; the app does not start without it) ---
DATABASE_URL=postgresql://freeagents:***@localhost:5432/freeagents

# --- Runtime ---
PORT=3000

# --- Credentials: platform issuer (optional; unset means an ephemeral dev
# key whose credentials do not survive a restart) ---
FREEAGENTS_PLATFORM_DID=
FREEAGENTS_PLATFORM_SEED=
FREEAGENTS_PUBLIC_BASE_URL=
FREEAGENTS_SOURCE_URL=

# --- GitHub sign-in, R-39 (optional; unset means the sign-in flow fails
# closed rather than exchanging against an empty client) ---
FREEAGENTS_GITHUB_CLIENT_ID=
FREEAGENTS_GITHUB_CLIENT_SECRET=
FREEAGENTS_GITHUB_REDIRECT_URI=

# --- Passkey sign-in (optional; unset disables passkey sign-in, GitHub
# OAuth is unaffected) ---
FREEAGENTS_PASSKEY_RP_ID=
FREEAGENTS_PASSKEY_RP_NAME=
FREEAGENTS_PASSKEY_ORIGIN=

# --- GitHub API, for the staging repository lifecycle: create, grant
# push, read commits, open the pull request (B14a), plus gist and
# merge-observation reads (optional; unset means the adapter fails
# closed with 503) ---
FREEAGENTS_GITHUB_TOKEN=
FREEAGENTS_GITHUB_PLATFORM_LOGIN=
FREEAGENTS_GITHUB_API_BASE=

# --- Declared intent for which payment rails this deployment runs
# (optional; unset or empty means the report below checks nothing extra,
# the existing behaviour). This does NOT restrict which rail the platform
# accepts a payment on; only a rail's own four variables decide that.
# Naming a rail here only changes what the startup configuration report
# checks: a rail named here that is not fully configured, or a name that
# is not abt/usdc, is flagged as a problem rather than passed through
# silently. ---
FREEAGENTS_ENABLED_RAILS=

# --- ABT payment rail (all four required for this rail to take a payment;
# unset means the rail fails closed rather than building a transfer) ---
FREEAGENTS_ABT_CHAIN_HOST=
FREEAGENTS_ABT_PLATFORM_SK=
FREEAGENTS_ABT_TOKEN=
FREEAGENTS_ABT_FEE_ADDRESS=

# --- USDC payment rail on Arbitrum (all four required for this rail to
# take a payment; unset means the rail fails closed rather than building a
# transfer) ---
FREEAGENTS_USDC_RPC_URL=
FREEAGENTS_USDC_TOKEN_CONTRACT=
FREEAGENTS_USDC_CHAIN_ID=
FREEAGENTS_USDC_FEE_ADDRESS=
