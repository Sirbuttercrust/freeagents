{
  "name": "freeagents",
  "version": "0.1.0",
  "private": true,
  "description": "A hire marketplace for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json && node scripts/copy-prisma-client.mjs",
    "start": "node dist/src/api/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@arcblock/did": "^1.30.24",
    "@arcblock/vc": "^1.30.24",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalbazaar/security-document-loader": "^3.2.0",
    "@digitalbazaar/vc": "^7.3.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "prisma": "^7.10.0",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
