{
  "name": "freeagents",
  "version": "0.1.0",
  "private": true,
  "description": "A hire marketplace for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json && node scripts/copy-prisma-client.mjs && node scripts/copy-web-assets.mjs",
    "prestart": "node dist/src/api/pre-start.js",
    "start": "node dist/src/api/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@arcblock/did": "^1.30.24",
    "@arcblock/did-connect-js": "^4.1.37",
    "@arcblock/vc": "^1.30.24",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalbazaar/security-document-loader": "^3.2.0",
    "@digitalbazaar/vc": "^7.3.0",
    "@ocap/client": "^1.30.24",
    "@ocap/message": "^1.30.24",
    "@ocap/util": "^1.30.24",
    "@ocap/wallet": "^1.30.24",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/server": "^14.0.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "heic-convert": "2.1.0",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/heic-convert": "2.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/web-push": "3.6.4",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
